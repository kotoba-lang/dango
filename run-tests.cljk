;; kbb --backend sci --classpath src:resources:test run-tests.cljk
;; Exit 1 on any failure or error, and also when ZERO assertions ran --
;; a suite that loaded nothing must not read as green.
(ns run-tests
  (:require [cljs.test :as t]
            [dango.shape-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (let [n (+ (:pass m 0) (:fail m 0) (:error m 0))]
    (println "ASSERTIONS" n "pass" (:pass m 0) "fail" (:fail m 0) "error" (:error m 0))
    (set! (.-exitCode js/process) (if (and (pos? n) (t/successful? m)) 0 1))))

(t/run-tests 'dango.shape-test)
