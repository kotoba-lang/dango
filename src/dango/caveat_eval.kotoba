;; dango.caveat-eval -- the caveat evaluator in Kotoba (ADR-2609242100 §9).
;;
;; The same three-valued (Kleene) semantics as dango.caveat in
;; src/dango/caveat.cljk, which stays the oracle: 0 = false, 1 = true,
;; 2 = unknown, and only a final 1 holds. A caveat arrives here as a TYPED
;; tree (:dango/term), not as the wire value -- turning the wire form
;; [:and [:<= :req/bytes 10] ...] into this tree, and refusing malformed
;; forms, is dango.caveat/problems + the host binding for now.
;;
;; TEMPORARY CONSTRAINTS (remove when the condition is met):
;; - Every value is a typed record / variant, and a request's absent fact is
;;   a has-* flag, because osaho admits no untyped map. Permanent in shape;
;;   the flags go if [:option :string] record fields qualify on native.
;; - A tree is bounded by osaho's shared ADT node budget (adt-node-limit, 64
;;   when measured 2026-09-24) that every target re-checks. dango.caveat's
;;   256-node wire bound is therefore NOT reachable here; a caveat larger
;;   than the budget cannot be evaluated natively until the budget grows.
;; - Parsing the wire value into this tree is not here: that needs the
;;   kotoba.value.v1 decoder as a guest module (the codec-binding step).
;; This module is one piece of the whole-component port (q9-migration.edn:
;; :decision-only-slices-allowed false), not the migration; nothing cuts
;; over on it alone.
(ns dango.caveat-eval
  (:export [holds t-fact t-int t-str t-kw t-bool t-set t-and t-or t-not t-cmp
            nil-terms cons-term request])
  (:schemas {:dango/term [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]]
             :dango/terms [:variant :dango/terms [[:end :i64] [:more [:vector [[:ref :dango/term] [:ref :dango/terms]]]]]]
             :dango/val [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]]
             :dango/request [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]]}))

;; The schema cycles are kept to two steps (term -> terms -> term, term ->
;; term): osaho refuses a deeper schema graph ("schema graph exceeds depth
;; limit", measured 2026-09-24 with a term -> app -> terms -> cell -> term
;; shape). So each operator is its own variant case, a comparison carries its
;; code in a heterogeneous vector [code left right], and a list cell is a
;; two-element vector [head tail].
;; comparison codes: 4 =, 5 <, 6 <=, 7 >, 8 >=, 9 prefix?, 10 member?
;; fact codes: 1 path, 2 bytes, 3 now, 4 kind, 5 resource, 6 holder

;; ── constructors (the host binding builds trees with these) ─────────────────

(defn nil-terms [] [:ref :dango/terms]
  (variant-new [:variant :dango/terms [[:end :i64] [:more [:vector [[:ref :dango/term] [:ref :dango/terms]]]]]] :end 0))

(defn cons-term [h [:ref :dango/term] t [:ref :dango/terms]] [:ref :dango/terms]
  (variant-new [:variant :dango/terms [[:end :i64] [:more [:vector [[:ref :dango/term] [:ref :dango/terms]]]]]] :more (hetero-vector [:vector [[:ref :dango/term] [:ref :dango/terms]]] h t)))

(defn t-fact [c :i64] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :fact c))
(defn t-int [n :i64] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :int n))
(defn t-str [s :string] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :str s))
(defn t-kw [s :string] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :kw s))
(defn t-bool [b :i64] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :bool b))
(defn t-set [l [:ref :dango/terms]] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :set l))
(defn t-and [l [:ref :dango/terms]] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :and l))
(defn t-or [l [:ref :dango/terms]] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :or l))
(defn t-not [x [:ref :dango/term]] [:ref :dango/term] (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :not x))
(defn t-cmp [code :i64 a [:ref :dango/term] b [:ref :dango/term]] [:ref :dango/term]
  (variant-new [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]] :cmp (hetero-vector [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]] code a b)))

(defn request [has-path :i64 path :string has-bytes :i64 bytes :i64 has-now :i64 now :i64
               has-kind :i64 kind :string has-resource :i64 resource :string
               has-holder :i64 holder :string] [:ref :dango/request]
  (record-new [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]]
              has-path path has-bytes bytes has-now now has-kind kind
              has-resource resource has-holder holder))

;; ── values ───────────────────────────────────────────────────────────────────

(defn v-unknown [] [:ref :dango/val] (variant-new [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]] :unknown 0))
(defn v-int [n :i64] [:ref :dango/val] (variant-new [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]] :int n))
(defn v-str [s :string] [:ref :dango/val] (variant-new [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]] :str s))
(defn v-kw [s :string] [:ref :dango/val] (variant-new [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]] :kw s))
(defn v-bool [b :i64] [:ref :dango/val] (variant-new [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]] :bool b))
(defn v-set [l [:ref :dango/terms]] [:ref :dango/val] (variant-new [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]] :set l))

;; tag: 0 unknown, 1 int, 2 str, 3 kw, 4 bool, 5 set
(defn tag [v [:ref :dango/val]] :i64
  (match-variant v [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]]
    (:unknown _ 0) (:int _ 1) (:str _ 2) (:kw _ 3) (:bool _ 4) (:set _ 5)))

(defn ival [v [:ref :dango/val]] :i64
  (match-variant v [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]]
    (:unknown _ 0) (:int n n) (:str _ 0) (:kw _ 0) (:bool b b) (:set _ 0)))

(defn sval [v [:ref :dango/val]] :string
  (match-variant v [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]]
    (:unknown _ "") (:int _ "") (:str x x) (:kw x x) (:bool _ "") (:set _ "")))

(defn set-of [v [:ref :dango/val]] [:ref :dango/terms]
  (match-variant v [:variant :dango/val [[:unknown :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]]]]
    (:unknown _ (nil-terms)) (:int _ (nil-terms)) (:str _ (nil-terms)) (:kw _ (nil-terms))
    (:bool _ (nil-terms)) (:set l l)))

(defn has [rq [:ref :dango/request] c :i64] :i64
  (cond (= c 1) (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :has-path)
        (= c 2) (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :has-bytes)
        (= c 3) (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :has-now)
        (= c 4) (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :has-kind)
        (= c 5) (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :has-resource)
        (= c 6) (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :has-holder)
        :else 0))

(defn fact-val [c :i64 rq [:ref :dango/request]] [:ref :dango/val]
  (cond
    (not (= 1 (has rq c))) (v-unknown)
    (= c 1) (v-str (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :path))
    (= c 2) (v-int (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :bytes))
    (= c 3) (v-int (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :now))
    (= c 4) (v-kw (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :kind))
    (= c 5) (v-str (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :resource))
    (= c 6) (v-str (record-get [:record :dango/request [[:has-path :i64] [:path :string] [:has-bytes :i64] [:bytes :i64] [:has-now :i64] [:now :i64] [:has-kind :i64] [:kind :string] [:has-resource :i64] [:resource :string] [:has-holder :i64] [:holder :string]]] rq :holder))
    :else (v-unknown)))

;; `s` starts with `p`, on UTF-8 bytes (the same bytes clojure.string
;; compares for these ASCII-safe prefixes). Written here rather than required
;; from kotoba.lang.text: that module also carries a [:list :string]
;; function, which the native target does not qualify (measured 2026-09-24),
;; and linking it refuses the whole program.
(defn prefix-of? [s :string p :string] :i64
  (if (> (string-length p) (string-length s))
    0
    (if (string=? (string-substring s 0 (string-length p)) p) 1 0)))

;; ── three-valued evaluation ──────────────────────────────────────────────────

;; equality: same tag (int/int, str/str, kw/kw, bool/bool) compares, anything
;; else -- different tags, sets, unknown -- is unknown.
(defn eq3 [a [:ref :dango/val] b [:ref :dango/val]] :i64
  (let [ta (tag a) tb (tag b)]
    (cond
      (not (= ta tb)) 2
      (or (= ta 1) (= ta 4)) (if (= (ival a) (ival b)) 1 0)
      (or (= ta 2) (= ta 3)) (if (string=? (sval a) (sval b)) 1 0)
      :else 2)))

;; a set member is a literal: facts and operators are not admitted inside a
;; set literal (dango.caveat/literal?), so they read as unknown here.
(defn lit [t [:ref :dango/term]] [:ref :dango/val]
  (match-variant t [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]]
    (:fact _ (v-unknown)) (:int n (v-int n)) (:str x (v-str x)) (:kw x (v-kw x))
    (:bool b (v-bool b)) (:set l (v-set l))
    (:and _ (v-unknown)) (:or _ (v-unknown)) (:not _ (v-unknown)) (:cmp _ (v-unknown))))

(defn member3 [a [:ref :dango/val] l [:ref :dango/terms]] :i64
  (match-variant l [:variant :dango/terms [[:end :i64] [:more [:vector [[:ref :dango/term] [:ref :dango/terms]]]]]]
    (:end _ 0)
    (:more c (if (= 1 (eq3 a (lit (hetero-vector-at [:vector [[:ref :dango/term] [:ref :dango/terms]]] c 0))))
               1
               (member3 a (hetero-vector-at [:vector [[:ref :dango/term] [:ref :dango/terms]]] c 1))))))

(defn compare3 [code :i64 a [:ref :dango/val] b [:ref :dango/val]] :i64
  (let [ta (tag a) tb (tag b)]
    (cond
      (or (= ta 0) (= tb 0)) 2
      (= code 4) (eq3 a b)
      (and (>= code 5) (<= code 8))
      (if (and (= ta 1) (= tb 1))
        (let [x (ival a) y (ival b)]
          (cond (= code 5) (if (< x y) 1 0)
                (= code 6) (if (<= x y) 1 0)
                (= code 7) (if (> x y) 1 0)
                :else (if (>= x y) 1 0)))
        2)
      (= code 9) (if (and (= ta 2) (= tb 2))
                   (prefix-of? (sval a) (sval b))
                   2)
      (= code 10) (if (= tb 5) (member3 a (set-of b)) 2)
      :else 2)))

(defn val->tri [v [:ref :dango/val]] :i64
  (if (= (tag v) 4) (ival v) 2))

(defn not3 [r :i64] :i64 (cond (= r 0) 1 (= r 1) 0 :else 2))

;; ev: a term's value. An operator's value is its truth as :bool, or unknown.
(defn ev [t [:ref :dango/term] rq [:ref :dango/request]] [:ref :dango/val]
  (match-variant t [:variant :dango/term [[:fact :i64] [:int :i64] [:str :string] [:kw :string] [:bool :i64] [:set [:ref :dango/terms]] [:and [:ref :dango/terms]] [:or [:ref :dango/terms]] [:not [:ref :dango/term]] [:cmp [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]]]]]
    (:fact c (fact-val c rq))
    (:int n (v-int n)) (:str x (v-str x)) (:kw x (v-kw x)) (:bool b (v-bool b)) (:set l (v-set l))
    (:and l (tri->val (and3 l rq 1)))
    (:or l (tri->val (or3 l rq 0)))
    (:not x (tri->val (not3 (val->tri (ev x rq)))))
    (:cmp v (tri->val (compare3 (hetero-vector-at [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]] v 0)
                                (ev (hetero-vector-at [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]] v 1) rq)
                                (ev (hetero-vector-at [:vector [:i64 [:ref :dango/term] [:ref :dango/term]]] v 2) rq))))))

(defn tri->val [r :i64] [:ref :dango/val]
  (if (= r 2) (v-unknown) (v-bool r)))

;; and: false if any false; true if all true; else unknown. acc: 1 so far all
;; true, 2 some unknown seen.
(defn and3 [l [:ref :dango/terms] rq [:ref :dango/request] acc :i64] :i64
  (match-variant l [:variant :dango/terms [[:end :i64] [:more [:vector [[:ref :dango/term] [:ref :dango/terms]]]]]]
    (:end _ acc)
    (:more c (let [r (val->tri (ev (hetero-vector-at [:vector [[:ref :dango/term] [:ref :dango/terms]]] c 0) rq))]
               (if (= r 0)
                 0
                 (and3 (hetero-vector-at [:vector [[:ref :dango/term] [:ref :dango/terms]]] c 1) rq (if (= r 2) 2 acc)))))))

;; or: true if any true; false if all false; else unknown. acc: 0 so far all
;; false, 2 some unknown seen.
(defn or3 [l [:ref :dango/terms] rq [:ref :dango/request] acc :i64] :i64
  (match-variant l [:variant :dango/terms [[:end :i64] [:more [:vector [[:ref :dango/term] [:ref :dango/terms]]]]]]
    (:end _ acc)
    (:more c (let [r (val->tri (ev (hetero-vector-at [:vector [[:ref :dango/term] [:ref :dango/terms]]] c 0) rq))]
               (if (= r 1)
                 1
                 (or3 (hetero-vector-at [:vector [[:ref :dango/term] [:ref :dango/terms]]] c 1) rq (if (= r 2) 2 acc)))))))

(defn holds [t [:ref :dango/term] rq [:ref :dango/request]] :i64
  (if (= (val->tri (ev t rq)) 1) 1 0))
